{
  "name": "wowstylist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pipeline:install": "cd pipeline && ./py -m pip install -r requirements.txt",
    "pipeline": "cd pipeline && ./py -m uvicorn api.main:app --reload --port 8000",
    "pipeline:health": "curl -s http://127.0.0.1:8000/health",
    "db:doctor": "cd pipeline && ./py -m fashion_retrieval.doctor",
    "db:migrate": "cd pipeline && ./py -m fashion_retrieval.migrate",
    "ig": "cd pipeline && ./py -m fashion_retrieval.pipeline",
    "richmenu": "node scripts/richmenu.mjs",
    "kb:crawl": "node scripts/style-kb/crawl.mjs",
    "kb:crawl:dry": "node scripts/style-kb/crawl.mjs --dry",
    "kb:report": "node scripts/style-kb/report.mjs",
    "kb:bench": "node scripts/style-kb/bench.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "json5": "^2.2.3",
    "next": "^15.5.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.0"
  }
}
