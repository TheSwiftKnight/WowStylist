# 複製這個檔案為 .env，然後填入你在 LINE Developers Console 拿到的值
# （設定步驟見 SETUP.md）

# Messaging API channel 的 Channel secret（Basic settings 分頁）
LINE_CHANNEL_SECRET=""

# Messaging API 分頁最下面發行的 Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=""

# ── Prisma Postgres 連線 ──────────────────────────────────────────────
# 兩條字串帳密一樣，只差主機名。到 Prisma Console（或 Vercel 的 Storage 頁）
# 複製 integration 給的那條，然後：
#   DATABASE_URL → 把 host 改成 pooled.db.prisma.io（連線池，app 執行時用）
#   DIRECT_URL   → 維持 db.prisma.io（prisma db push / migrate / studio 用）
DATABASE_URL=""
DIRECT_URL=""

# ── 打字對話（src/lib/chat.ts）──
# 對話引擎："rules"（關鍵字規則，不用金鑰）| "anthropic" | "openai"
CHAT_PROVIDER="rules"
# 用 LLM 時填對應金鑰；CHAT_MODEL 可覆寫預設模型（anthropic 預設 claude-haiku-4-5、openai 預設 gpt-4o-mini）
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
CHAT_MODEL=""

# ── Rich Menu（scripts/richmenu.mjs）──
# 選單「打開網站」按鈕要開的網址（開發期填 ngrok 網址，上線填正式網域）
SITE_URL=""

# ── Style KB 爬蟲（scripts/style-kb）──
# 搜尋層三選一：Exa（建議，一個 call 搜尋+內文）/ Serper / Brave
EXA_API_KEY=""
SERPER_API_KEY=
BRAVE_API_KEY=

# 抽取層（填穿搭 slot 的 LLM）。預設走 OpenRouter 的 Nemotron 3 Ultra free。
OPENROUTER_API_KEY=
# 覆寫 provider："openrouter"（預設）| "openai" | "anthropic"
KB_LLM_PROVIDER=
# 覆寫模型，可省略。openrouter 預設 nvidia/nemotron-3-ultra-550b-a55b:free
KB_EXTRACT_MODEL=
