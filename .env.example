# 複製這個檔案為 .env，然後填入你在 LINE Developers Console 拿到的值
# （設定步驟見 SETUP.md）

# Messaging API channel 的 Channel secret（Basic settings 分頁）
LINE_CHANNEL_SECRET=""

# Messaging API 分頁最下面發行的 Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=""

# ── Instagram RDS（pipeline 寫、網站讀）──────────────────────
# Prisma 已經拿掉了。schema 由 pipeline/migrations/001_fashion_items.sql 管，
# 這邊只用 pg 直接下 SQL。
DB_HOST=""
DB_PORT="5432"
DB_NAME="postgres"
DB_USER=""
DB_PASSWORD=""
DB_SSLMODE="require"
# Python pipeline 單次 DB 連線逾時秒數；逾時且 RDS DNS 指到私網時會自動改走公共 DNS
DB_CONNECT_TIMEOUT="10"
# 統一單品表的表名（schema 見 pipeline/migrations/001_fashion_items.sql）
FASHION_TABLE="fashion_items"

# ── 分析 pipeline（./pipeline，Python + FastAPI）──────────────
# 這個 .env 同時給 Next.js 和 Python 用（python-dotenv 會往上找到這一份），
# 所以金鑰只放這裡一份，不用再維護 pipeline/.env。

# Instagram 抓取
APIFY_TOKEN=""

# BGE-M3 語意向量（Hugging Face Inference API）
# 沒填的話 fashion_encoder.py 在 import 時就會 RuntimeError，服務起不來
HF_TOKEN=""

# Next.js 打 pipeline 的位址：cd pipeline && uvicorn api.main:app --port 8000
PIPELINE_API_URL="http://127.0.0.1:8000"
# 共享密鑰，留空 = 不檢查（本機 dev）
PIPELINE_TOKEN=""
# 允許打 pipeline 的前端網址，逗號分隔
ALLOWED_ORIGINS="http://localhost:3000"
# Reel 同一套衣服的去重門檻（0 = 關掉）
GARMENT_DEDUP_THRESHOLD="0.82"

# ── 打字對話（src/lib/chat.ts）──
# 對話引擎："rules"（關鍵字規則，不用金鑰）| "anthropic" | "openai"
CHAT_PROVIDER="rules"
# 用 LLM 時填對應金鑰；CHAT_MODEL 可覆寫預設模型（anthropic 預設 claude-haiku-4-5、openai 預設 gpt-4o-mini）
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
CHAT_MODEL=""

# ── Rich Menu（scripts/richmenu.mjs）──
# 選單「打開網站」按鈕要開的網址（開發期填 ngrok 網址，上線填正式網域）
SITE_URL=""

# ── Style KB 爬蟲（scripts/style-kb）──
# 搜尋層三選一：Exa（建議，一個 call 搜尋+內文）/ Serper / Brave
EXA_API_KEY=""
SERPER_API_KEY=
BRAVE_API_KEY=

# 抽取層（填穿搭 slot 的 LLM）。預設走 OpenRouter 的 Nemotron 3 Ultra free。
OPENROUTER_API_KEY=
# 覆寫 provider："openrouter"（預設）| "openai" | "anthropic"
KB_LLM_PROVIDER=
# 覆寫模型，可省略。openrouter 預設 nvidia/nemotron-3-ultra-550b-a55b:free
KB_EXTRACT_MODEL=
