# 複製這個檔案為 .env，然後填值。
# 這一份同時給 Next.js 和 pipeline/ 的 Python 用。

# Messaging API channel 的 Channel secret（Basic settings 分頁）
LINE_CHANNEL_SECRET=""

# Messaging API 分頁最下面發行的 Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=""

# ── Instagram RDS（pipeline 寫、網站讀）──────────────────────
# Prisma 已經拿掉了。schema 由 pipeline/migrations/001_fashion_items.sql 管，
# 這邊只用 pg 直接下 SQL。
DB_HOST=""
DB_PORT="5432"
DB_NAME="postgres"
DB_USER=""
DB_PASSWORD=""
DB_SSLMODE="require"
# Python pipeline 單次 DB 連線逾時秒數；逾時且 RDS DNS 指到私網時會自動改走公共 DNS
DB_CONNECT_TIMEOUT="10"
# 統一單品表的表名（schema 見 pipeline/migrations/001_fashion_items.sql）
FASHION_TABLE="fashion_items"

# ── 商品 RDS（推薦排序讀，只讀不寫）─────────────────────────
# 跟上面的 IG RDS 是「不同的兩台機器」。
#   IG RDS（DB_*）          ← pipeline 寫進來的 IG 單品 = 使用者偏好
#   商品 RDS（PRODUCTS_DB_*）← 電商商品 + 它們的向量 = 推薦的候選
# 兩邊都是 BGE-M3 編碼、都已 L2 normalize，所以在同一個語意空間。
#
# 留空的話商品會沿用 IG 那條連線（兩批資料放同一台時才這樣設）。
PRODUCTS_DB_HOST=""
PRODUCTS_DB_PORT="5432"
PRODUCTS_DB_NAME="postgres"
PRODUCTS_DB_USER=""
PRODUCTS_DB_PASSWORD=""
PRODUCTS_DB_SSLMODE="require"
PRODUCTS_TABLE="products"

# 使用者還沒有任何收藏時，要不要退回「全體收藏」當偏好。
# false = 照 rank_products.py 的原語意（沒紀錄就純看這次查詢）
RANK_FALLBACK_GLOBAL_PREFS="true"

# ── 分析 pipeline（./pipeline，Python + FastAPI）──────────────
# 這個 .env 同時給 Next.js 和 Python 用（python-dotenv 會往上找到這一份），
# 所以金鑰只放這裡一份，不用再維護 pipeline/.env。

# Instagram 抓取
APIFY_TOKEN=""

# BGE-M3 語意向量（Hugging Face Inference API）
# 沒填的話 fashion_encoder.py 在 import 時就會 RuntimeError，服務起不來
HF_TOKEN=""

# Next.js 打 pipeline 的位址：cd pipeline && uvicorn api.main:app --port 8000
PIPELINE_API_URL="http://127.0.0.1:8000"
# 共享密鑰，留空 = 不檢查（本機 dev）。
# 部署到公開網址（Render 之類）時一定要設，兩邊填一樣的。
PIPELINE_TOKEN=""
# 送件逾時（毫秒）。免費方案閒置後冷啟動要一分鐘左右，所以給 60 秒。
PIPELINE_TIMEOUT_MS="60000"
# 允許打 pipeline 的前端網址，逗號分隔
ALLOWED_ORIGINS="http://localhost:3000"
# Reel 同一套衣服的去重門檻（0 = 關掉）
GARMENT_DEDUP_THRESHOLD="0.82"

# ── 打字對話（src/lib/chat.ts）──
# 對話引擎：留空 = 自動偵測（有 ANTHROPIC_API_KEY 就用 Claude）
#   "anthropic"（預設，接 Claude Messages API）| "openai" | "rules"（關鍵字規則，不用金鑰）
CHAT_PROVIDER=""

# Claude API 金鑰。取得：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# 指定模型（留空使用預設 claude-haiku-4-5-20251001 —— 最快最便宜）
# 想更準可改 claude-sonnet-5；LINE 有時間壓力，不建議用 opus
CHAT_MODEL=""

# Claude 單次呼叫逾時（毫秒）。整條流程跑在 webhook 的 after() 背景裡，
# Vercel Hobby 大約只有 15 秒，所以預設抓 8 秒。
CHAT_TIMEOUT_MS="8000"

# 備援 provider（CHAT_PROVIDER="openai" 時才需要）
OPENAI_API_KEY=""

# Debug 模式：LINE bot 回覆會帶上 provider/model 資訊及 LLM 原始 output，方便測試
# 上線前請設為 false 或移除
CHAT_DEBUG="true"

# ── Rich Menu（scripts/richmenu.mjs）──
# 選單「打開網站」按鈕要開的網址（開發期填 ngrok 網址，上線填正式網域）
SITE_URL=""

# ── Style KB 爬蟲（scripts/style-kb）──
# 搜尋層三選一：Exa（建議，一個 call 搜尋+內文）/ Serper / Brave
EXA_API_KEY=""
SERPER_API_KEY=
BRAVE_API_KEY=

# 抽取層（填穿搭 slot 的 LLM）。這支是離線批次爬蟲，跟上面的 LINE 對話各自獨立：
# 預設仍走 OpenRouter 的 deepseek-v4-flash（免費層，bench 實測最划算）。
OPENROUTER_API_KEY=""
# 覆寫 provider："openrouter"（預設）| "anthropic"（改用 Claude，要錢但沒有 200/day 上限）| "openai"
KB_LLM_PROVIDER=
# 覆寫模型，可省略。openrouter 預設 deepseek/deepseek-v4-flash-0731:free，
# anthropic 預設 claude-haiku-4-5
KB_EXTRACT_MODEL=
