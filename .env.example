# 複製這個檔案為 .env，然後填入你在 LINE Developers Console 拿到的值
# （設定步驟見 SETUP.md）

# Messaging API channel 的 Channel secret（Basic settings 分頁）
LINE_CHANNEL_SECRET=""

# Messaging API 分頁最下面發行的 Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=""

# Prisma 資料庫連線 —— 雲端 Postgres 的連線字串
# Prisma Postgres（Vercel integration）：到 Prisma Console 複製 pooled TCP 那條
#   postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres
# 之後換 AWS RDS 就換成 RDS 的 endpoint（記得走 RDS Proxy，不然 serverless 會把連線打爆）
# 注意：Vercel 上這個變數由 integration 自動注入，本機才需要自己填這裡
DATABASE_URL=""

# ── 打字對話（src/lib/chat.ts）──
# 對話引擎："openrouter"（推薦）| "anthropic" | "openai" | "rules"（關鍵字規則，不用金鑰）
CHAT_PROVIDER="openrouter"

# OpenRouter API 金鑰（CHAT_PROVIDER=openrouter 時填）
# 取得：https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# 指定模型（留空使用各 provider 預設）
# OpenRouter 預設：nvidia/nemotron-3-ultra-550b-a55b:free（免費）
# 其他選項：google/gemini-flash-1.5 | anthropic/claude-haiku-4-5 | openai/gpt-4o-mini
CHAT_MODEL=""

# 其他 provider 金鑰（CHAT_PROVIDER 對應時才需要填）
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Debug 模式：LINE bot 回覆會帶上 provider/model 資訊及 LLM 原始 output，方便測試
# 上線前請設為 false 或移除
CHAT_DEBUG="true"

# ── Rich Menu（scripts/richmenu.mjs）──
# 選單「打開網站」按鈕要開的網址（開發期填 ngrok 網址，上線填正式網域）
SITE_URL=""
