// Prisma schema — 雲端 Postgres（Prisma Postgres）。
//
// 兩條連線字串，帳密一樣、只差主機名：
//   DATABASE_URL → pooled.db.prisma.io  跑在 serverless 上的查詢走這條（經過連線池）
//   DIRECT_URL   → db.prisma.io         prisma db push / migrate / studio 走這條（繞過連線池）
//
// 兩條都是 postgres://USER:PASSWORD@<host>:5432/postgres?sslmode=require
// Vercel integration 預設只給 direct 那條（PRISMA_DATABASE_URL / POSTGRES_URL），
// pooled 的自己把 host 換成 pooled.db.prisma.io 就好。
//
// 之後換 AWS RDS：DATABASE_URL 指到 RDS Proxy、DIRECT_URL 指到 RDS 本體。
//
// 改完連線字串後跑一次：npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")  // pooled，app 執行時用
  directUrl = env("DIRECT_URL")    // direct，CLI 做 schema 變更時用
}

// 使用者透過 LINE 分享進來的 Instagram 連結
model SharedLink {
  id         Int      @id @default(autoincrement())
  url        String // 正規化後的 IG 連結
  shortcode  String   @unique // IG 貼文/Reel 的代碼（網址裡 /p/XXXX/ 的 XXXX）
  kind       String // "post" | "reel" | "tv" | "unknown"
  sourceText String? // 使用者傳來的原始訊息全文
  senderId   String? // LINE userId
  senderName String? // LINE 顯示名稱（抓得到才有）
  createdAt  DateTime @default(now())

  // 從 IG embed 頁解析出來的內容（可能抓不到，皆可為空）
  username    String? // 發文者帳號
  caption     String? // 貼文文字內容
  mediaPath   String? // 下載到本機的圖片/縮圖（/media/xxx.jpg）
  isVideo     Boolean   @default(false) // Reels / 影片貼文
  fetchStatus String? // null=還沒抓 | "ok" | "failed"
  fetchedAt   DateTime?
}

// style 風向標的標籤（風格 / 色系 / 形容詞）
model StyleTag {
  id      String @id @default(cuid())
  label   String
  kind    String // "style" | "color" | "mood"
  weight  Float  @default(0.5) // 0~1，決定在風向標上的字級

  ownerId String? // LINE userId，之後要分使用者時用

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weight])
}
