// Prisma schema — 雲端 Postgres。
//
// DATABASE_URL 要放「一般的 postgres:// 連線字串」，例如
//   postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres   （Prisma Postgres 的 pooled TCP）
//   postgres://USER:PASSWORD@<rds-endpoint>:5432/wowstylist      （之後換 AWS RDS）
//
// 如果 Vercel integration 給你的是 prisma+postgres://accelerate... 開頭的網址，
// 去 Prisma Console 拿 pooled TCP 那條，不然要另外裝 @prisma/extension-accelerate。
//
// 改完連線字串後跑一次：npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 使用者透過 LINE 分享進來的 Instagram 連結
model SharedLink {
  id         Int      @id @default(autoincrement())
  url        String // 正規化後的 IG 連結
  shortcode  String   @unique // IG 貼文/Reel 的代碼（網址裡 /p/XXXX/ 的 XXXX）
  kind       String // "post" | "reel" | "tv" | "unknown"
  sourceText String? // 使用者傳來的原始訊息全文
  senderId   String? // LINE userId
  senderName String? // LINE 顯示名稱（抓得到才有）
  createdAt  DateTime @default(now())

  // 從 IG embed 頁解析出來的內容（可能抓不到，皆可為空）
  username    String? // 發文者帳號
  caption     String? // 貼文文字內容
  mediaPath   String? // 下載到本機的圖片/縮圖（/media/xxx.jpg）
  isVideo     Boolean   @default(false) // Reels / 影片貼文
  fetchStatus String? // null=還沒抓 | "ok" | "failed"
  fetchedAt   DateTime?
}
